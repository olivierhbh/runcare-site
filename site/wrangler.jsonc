// Configuration du Worker Cloudflare. L'adaptateur Astro la complète au build
// dans dist/server/wrangler.json, qui est le fichier réellement déployé.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "runcare-site",
  "compatibility_date": "2026-09-17",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    // Comme sur Vercel (trailingSlash: 'never') : /blog sert la page, /blog/ redirige vers /blog.
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "404-page",
    // Sans cette liste, une navigation vers /keystatic (aucun fichier statique)
    // n'invoquerait jamais le Worker et répondrait 404.
    "run_worker_first": ["/keystatic", "/keystatic/*", "/api/*"]
  },
  // Le domaine passe par Cloudflare (enregistrement DNS proxifié) et cette
  // route envoie toutes ses requêtes au Worker.
  "routes": [{ "pattern": "argonnekinesportsante.fr/*", "zone_name": "argonnekinesportsante.fr" }],
  "observability": { "enabled": true }
}
