---
import Logo from './Logo.astro';
import { settings, telHref, whatsappUrl, runcareNav, cabinet } from '@/lib/settings';
const year = new Date().getFullYear();
---
<footer class="border-t hairline mt-auto">
  <div class="container py-14 grid gap-10 md:grid-cols-[1.4fr_1fr_1fr_1fr]">
    <div>
      <Logo />
      <p class="muted mt-4 max-w-xs text-sm leading-relaxed">Cabinet de kinésithérapie du sport à Bordeaux. RunCare est notre programme dédié au coureur à pied.</p>
    </div>
    <div>
      <p class="eyebrow mb-3">Cabinet</p>
      <ul class="space-y-2 text-sm">
        <li><a class="hover:text-accent" href="/kinesitherapie">Kinésithérapie</a></li>
        <li><a class="hover:text-accent" href="/equipe">L’équipe</a></li>
        <li><a class="hover:text-accent" href="/blog">Conseils</a></li>
        <li><a class="hover:text-accent" href="/contact">Contact &amp; FAQ</a></li>
      </ul>
    </div>
    <div>
      <p class="eyebrow mb-3">RunCare</p>
      <ul class="space-y-2 text-sm">
        <li><a class="hover:text-accent" href="/runcare">Le programme du coureur</a></li>
        {runcareNav.map((n) => <li><a class="hover:text-accent" href={n.href}>{n.label}</a></li>)}
        <li><a class="hover:text-accent" href={settings.leadMagnetUrl || '/profil-coureur'} rel="noopener">Quel coureur êtes-vous ?</a></li>
      </ul>
    </div>
    <div>
      <p class="eyebrow mb-3">Contact</p>
      <address class="not-italic text-sm space-y-2">
        <p>{settings.adresse}<br />{settings.codePostal} {settings.ville}</p>
        <p><a class="hover:text-accent" href={telHref}>{settings.telephone}</a></p>
        <p><a class="hover:text-accent" href={whatsappUrl()} rel="noopener">WhatsApp</a></p>
        <p><a class="hover:text-accent" href={settings.doctolibRomain} rel="noopener">Doctolib</a></p>
      </address>
    </div>
  </div>
  <div class="border-t hairline">
    <div class="container py-5 flex flex-wrap gap-x-6 gap-y-2 text-xs muted">
      <span>© {year} {cabinet.nom}</span>
      <a class="hover:text-accent" href="/mentions-legales">Mentions légales</a>
      <a class="hover:text-accent" href="/politique-de-confidentialite">Politique de confidentialité</a>
    </div>
  </div>
</footer>
