---
import { Image } from 'astro:assets';
interface Props { eyebrow?: string; title: string; intro?: string; photo?: ImageMetadata; photoAlt?: string }
const { eyebrow, title, intro, photo, photoAlt = '' } = Astro.props;
---
<section class="container pt-14 md:pt-20 pb-10">
  <div class="grid gap-10 lg:grid-cols-[1.1fr_1fr] items-end">
    <div>
      {eyebrow && <p class="eyebrow mb-4">{eyebrow}</p>}
      <h1 class="text-[clamp(2.4rem,5.5vw,4rem)]">{title}</h1>
      {intro && <p class="mt-6 text-lg md:text-xl muted max-w-[58ch] leading-relaxed">{intro}</p>}
      <slot />
    </div>
    {photo && (
      <div class="rounded-brand overflow-hidden aspect-[4/3] bg-bg-2">
        <Image src={photo} alt={photoAlt} width={1000} class="w-full h-full object-cover img-tone" />
      </div>
    )}
  </div>
</section>
