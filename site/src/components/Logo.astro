---
import Runner from '@/assets/logo-runner.svg';
import { Image } from 'astro:assets';
import { cabinet } from '@/lib/settings';
import argonne from '@/assets/logo-argonne.png';
interface Props { class?: string; size?: 'sm' | 'md' | 'lg'; variant?: 'cabinet' | 'runcare'; link?: boolean }
const { class: cls = '', size = 'md', variant = 'cabinet', link = true } = Astro.props;
const h = { sm: 26, md: 34, lg: 48 }[size];
const main = { sm: 'text-[1.15rem]', md: 'text-[1.2rem] sm:text-[1.45rem]', lg: 'text-[2rem]' }[size];
const Tag = link ? 'a' : 'span';
const href = variant === 'runcare' ? '/runcare' : '/';
---
{variant === 'runcare' ? (
  <Tag href={link ? href : undefined} class={`logo inline-flex items-center gap-2.5 ${cls}`} aria-label={link ? 'RunCare — le programme du coureur' : undefined}>
    <Runner height={h} width={h * 1.09} aria-hidden="true" class="shrink-0" />
    <span class="leading-none" style="font-family: var(--font-logo)">
      <span class:list={['block font-semibold tracking-[-0.01em]', main]}>Run<span class="text-accent">Care</span></span>
      <span class="mt-[3px] text-[0.5rem] font-medium tracking-[0.3em] uppercase opacity-75 flex items-center gap-1.5 whitespace-nowrap">
        <span class="hidden sm:block h-px w-3 bg-current opacity-60"></span>Kiné &amp; Coach<span class="hidden sm:block h-px w-3 bg-current opacity-60"></span>
      </span>
    </span>
  </Tag>
) : (
  <Tag href={link ? href : undefined} class={`logo inline-flex items-center gap-2.5 ${cls}`} aria-label={link ? `${cabinet.nom} — accueil` : undefined}>
    <Image src={argonne} alt={cabinet.nom} height={Math.round(h * 1.6)} densities={[1, 2, 3]} class="block w-auto" style={`height:${Math.round(h * 1.6)}px`} loading="eager" />
  </Tag>
)}
