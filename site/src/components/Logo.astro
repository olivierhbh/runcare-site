---
import { Image } from 'astro:assets';
import Runner from '@/assets/logo-runner.svg';
import argonne from '@/assets/logo-argonne.png';
interface Props { class?: string; size?: 'sm' | 'md'; variant?: 'runcare' | 'argonne' }
const { class: cls = '', size = 'md', variant = 'runcare' } = Astro.props;
const h = size === 'sm' ? 26 : 34;
const ha = size === 'sm' ? 40 : 54; // logo Argonne (image, ratio ~2,24)
---
{variant === 'argonne' && (
  <a href="/" class={`logo inline-flex items-center ${cls}`} aria-label="Argonne Kiné Sport Santé, retour à l'accueil">
    <Image src={argonne} alt="Argonne Kiné Sport Santé" height={ha} densities={[1, 2, 3]} class="block w-auto" style={`height:${ha}px`} loading="eager" />
  </a>
)}
{variant !== 'argonne' && (
<a href="/" class={`logo inline-flex items-center gap-2.5 ${cls}`} aria-label="RunCare, retour à l'accueil">
  <Runner height={h} width={h * 1.09} aria-hidden="true" class="shrink-0" />
  <span class="leading-none" style="font-family: var(--font-logo)">
    <span class:list={['block font-semibold tracking-[-0.01em]', size === 'sm' ? 'text-[1.15rem]' : 'text-[1.45rem]']}>Run<span class="text-accent">Care</span></span>
    <span class="logo-tag mt-[3px] text-[0.5rem] font-medium tracking-[0.3em] uppercase opacity-75 flex items-center gap-1.5 whitespace-nowrap">
      <span class="hidden sm:block h-px w-3 bg-current opacity-60"></span>Kiné &amp; Coach<span class="hidden sm:block h-px w-3 bg-current opacity-60"></span>
    </span>
  </span>
</a>
)}
