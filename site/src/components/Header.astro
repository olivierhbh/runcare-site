---
import Logo from './Logo.astro';
import { nav, settings } from '@/lib/settings';
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
---
<header class="sticky top-0 z-40 backdrop-blur border-b hairline" style="background: color-mix(in srgb, var(--bg) 85%, transparent)">
  <div class="container flex items-center justify-between h-[4.25rem]">
    <Logo />
    <nav class="hidden lg:flex items-center gap-7 text-[0.92rem]">
      {nav.map((n) => (
        <a href={n.href} class:list={['hover:text-accent transition-colors text-center leading-tight', path.startsWith(n.href) && 'text-accent font-medium']}>
          {n.label}
          {n.tag && <span class:list={['block text-[0.55rem] font-semibold tracking-[0.18em] uppercase mt-0.5', n.tag === 'runcare' ? 'text-accent' : 'text-[var(--argonne)]']}>{n.tag === 'runcare' ? 'RunCare' : 'Argonne'}</span>}
        </a>
      ))}
    </nav>
    <div class="flex items-center gap-3">
      <a href="/contact" class="btn btn-primary !py-2.5 !px-4 text-sm">Prendre contact</a>
      <button id="menu-btn" class="lg:hidden p-2 -mr-2" aria-label="Menu" aria-expanded="false" aria-controls="mobile-nav">
        <svg width="22" height="22" viewBox="0 0 22 22" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M3 6h16M3 11h16M3 16h16"/></svg>
      </button>
    </div>
  </div>
  <nav id="mobile-nav" class="hidden lg:!hidden border-t hairline">
    <div class="container py-4 flex flex-col gap-3">
      {nav.map((n) => (
        <a href={n.href} class="py-1.5 text-lg serif flex items-baseline gap-2.5">
          {n.label}
          {n.tag && <span class:list={['text-[0.6rem] font-sans font-semibold tracking-[0.18em] uppercase', n.tag === 'runcare' ? 'text-accent' : 'text-[var(--argonne)]']}>{n.tag === 'runcare' ? 'RunCare' : 'Argonne'}</span>}
        </a>
      ))}
      <a href="/contact" class="py-1.5 text-lg serif">Contact</a>
      <p class="muted text-sm mt-2">{settings.adresse}, {settings.ville}</p>
    </div>
  </nav>
</header>
<script>
  const btn = document.getElementById('menu-btn');
  const nav = document.getElementById('mobile-nav');
  btn?.addEventListener('click', () => {
    const open = nav!.classList.toggle('hidden');
    btn.setAttribute('aria-expanded', String(!open));
  });
</script>
