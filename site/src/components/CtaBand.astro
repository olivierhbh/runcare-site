---
interface Props { title?: string; text?: string }
const { title = 'Tu ne sais pas quel service choisir ?', text = 'Décris-nous simplement ta situation et nous t’orienterons vers la solution la plus adaptée.' } = Astro.props;
---
<section class="section on-dark">
  <div class="container grid gap-8 md:grid-cols-[1.3fr_1fr] items-center">
    <div>
      <h2 class="text-[clamp(1.8rem,4vw,2.8rem)] max-w-xl">{title}</h2>
      <p class="muted mt-4 max-w-lg text-lg">{text}</p>
    </div>
    <div class="flex md:justify-end">
      <a class="btn btn-primary" href="/contact">Prendre contact</a>
    </div>
  </div>
</section>
