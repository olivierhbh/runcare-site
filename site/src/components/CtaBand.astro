---
import { whatsappUrl } from '@/lib/settings';
interface Props { title?: string; text?: string; whatsapp?: string }
const { title = 'Vous ne savez pas quel service choisir ?', text = 'Décrivez-nous simplement votre situation et nous vous orienterons vers la solution la plus adaptée.', whatsapp = whatsappUrl('Bonjour, je souhaite vous décrire ma situation pour savoir quel accompagnement me correspond.') } = Astro.props;
---
<section class="section on-dark">
  <div class="container grid gap-8 md:grid-cols-[1.3fr_1fr] items-center">
    <div>
      <h2 class="text-[clamp(1.8rem,4vw,2.8rem)] max-w-xl">{title}</h2>
      <p class="muted mt-4 max-w-lg text-lg">{text}</p>
    </div>
    <div class="flex flex-wrap gap-3 md:justify-end">
      <a class="btn btn-primary" href={whatsapp} rel="noopener">Écrire sur WhatsApp</a>
      <a class="btn btn-ghost" href="/contact">Voir les coordonnées</a>
    </div>
  </div>
</section>
