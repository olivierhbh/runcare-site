---
import { getCollection, getEntry, render } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '@/layouts/Base.astro';
import PageHero from '@/components/PageHero.astro';
import CtaBand from '@/components/CtaBand.astro';
import ArticleCard from '@/components/ArticleCard.astro';
import Flag from '@/components/Flag.astro';
import FlagBlock from '@/components/FlagBlock.astro';
import { whatsappCoachingUrl } from '@/lib/settings';
import nolio from '@/assets/photos/nolio.jpg';
import coachingTel from '@/assets/photos/coaching-tel.jpg';

const entry = (await getEntry('services', 'coaching'))!;
const { Content } = await render(entry);
const d = entry.data;
const formules = (await getCollection('formules')).sort((a, b) => a.data.ordre - b.data.ordre);
const articles = (await getCollection('articles')).filter((a) => a.data.service === 'coaching');
const rows: { label: string; key: keyof (typeof formules)[0]['data']['tableau'] | 'format' | 'engagement' | 'tarif' | 'pourQui' }[] = [
  { label: 'Pour qui ?', key: 'pourQui' },
  { label: 'Programme', key: 'programme' },
  { label: 'Planification', key: 'planification' },
  { label: 'Suivi', key: 'suivi' },
  { label: 'Ajustement', key: 'ajustement' },
  { label: 'Format', key: 'format' },
  { label: 'Engagement', key: 'engagement' },
  { label: 'Tarif', key: 'tarif' },
];
const cell = (f: (typeof formules)[0], key: (typeof rows)[0]['key']) =>
  key in f.data.tableau ? f.data.tableau[key as keyof typeof f.data.tableau] : (f.data as any)[key];
---
<Base title="Coaching du coureur" description={d.accroche} ogImage={nolio.src}>
  <PageHero eyebrow={d.besoin} title={d.titre} intro={d.intro} photo={coachingTel} photoAlt="Coureur consultant son plan d'entraînement" />

  <section class="container pb-16">
    <FlagBlock>Le brief nomme les formules de deux façons (« Gestion de charge / Préparation physique / Premium » dans le texte, « Essentiel / Force / Performance » dans le tableau). Nous avons retenu Essentiel / Force / Performance avec l’ancien nom en sous-titre. À valider.</FlagBlock>
    <div class="grid gap-5 lg:grid-cols-3 mt-4">
      {formules.map((f) => (
        <article class:list={['rounded-brand border p-7 flex flex-col gap-6 lg:grid lg:grid-rows-subgrid lg:row-span-6 lg:gap-y-6', f.data.misEnAvant ? 'on-dark border-transparent' : 'bg-surface hairline']}>
          <div>
            <p class="eyebrow mb-2">{f.data.sousTitre}</p>
            <h2 class="text-3xl">{f.data.nom}</h2>
            <p class="mt-3 muted leading-relaxed text-[0.95rem]">{f.data.description}</p>
          </div>
          <ul class="space-y-2 text-sm">
            {f.data.inclus.map((x) => <li class="flex gap-2.5"><span class="mt-0.5 shrink-0" style={f.data.misEnAvant ? '' : 'color: var(--accent)'}>✓</span><span>{x}</span></li>)}
          </ul>
          <p class="serif text-3xl self-end -mb-4">{f.data.tarif}</p>
          <div class="self-end">
            <p class="text-sm muted">{f.data.format} · {f.data.engagement}</p>
            <p class="text-xs muted mt-1">{f.data.tarifDetail}</p>
          </div>
          <a href={whatsappCoachingUrl(`Bonjour, je suis intéressé(e) par la formule ${f.data.nom}.`)} class="btn btn-primary w-full justify-center" rel="noopener">Choisir {f.data.nom}</a>
          <p class="text-sm border-t pt-4" style="border-color: color-mix(in srgb, currentColor 15%, transparent)"><span class="font-semibold">Idéal si :</span> {f.data.idealSi}</p>
        </article>
      ))}
    </div>
    <p class="mt-6 text-sm muted max-w-[70ch]"><Flag note="Prix Force : le brief dit « 120 € sans engagement » pour 3 mois avec 4 séances au cabinet. Vérifier qu'il s'agit bien d'un forfait de 120 € au total et non 120 €/mois.">La formule Force est un forfait unique de 120 € pour les 3 mois.</Flag> Chaque formule démarre par un Bilan Diagnostic RunCare, proposé à 60 € au lieu de 90 €. Le coaching RunCare est un acte de kinésithérapie préventive, hors nomenclature : non remboursé par l’Assurance Maladie.</p>
    <div class="mt-6 flex flex-wrap gap-3 items-center">
      <a href="/runcare/bilan" class="btn btn-primary">Commencer par un Bilan Diagnostic</a>
      <span class="text-sm muted">Vous hésitez entre les formules ? Le bilan permet de choisir celle qui a du sens pour vous.</span>
    </div>
  </section>

  <section class="section bg-bg-2">
    <div class="container">
      <p class="eyebrow mb-4">Comparer</p>
      <h2 class="text-[clamp(1.8rem,3.5vw,2.6rem)] mb-8">Les trois formules en un coup d’œil</h2>
      <div class="overflow-x-auto rounded-brand border hairline bg-surface">
        <table class="w-full text-sm min-w-[40rem]">
          <thead>
            <tr class="border-b hairline">
              <th class="text-left p-4 font-normal muted"></th>
              {formules.map((f, i) => <th class={`text-left p-4 svc-${i + 2}`}><span class="serif text-xl block">{f.data.nom}</span><span class="muted font-normal text-xs">{f.data.sousTitre}</span></th>)}
            </tr>
          </thead>
          <tbody>
            {rows.map((r) => (
              <tr class="border-b hairline last:border-0">
                <th class="text-left p-4 font-medium align-top">{r.label}</th>
                {formules.map((f) => <td class:list={['p-4 align-top', r.key === 'tarif' && 'font-semibold']}>{cell(f, r.key)}</td>)}
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container grid gap-10 lg:grid-cols-[1fr_1.2fr] items-center">
      <div class="prose"><Content /></div>
      <div class="rounded-brand overflow-hidden border hairline bg-surface p-3 shadow-sm">
        <Image src={nolio} alt="Exemple de programme d'entraînement sur la plateforme Nolio" width={1200} class="w-full rounded-[calc(var(--radius)-2px)]" />
        <p class="text-xs muted px-2 pt-3 pb-1">Exemple de programme d’un coureur sur la plateforme Nolio.</p>
      </div>
    </div>
  </section>

  {articles.length > 0 && (
    <section class="section pt-0">
      <div class="container">
        <p class="eyebrow mb-4">Pour aller plus loin</p>
        <div class="grid gap-5 md:grid-cols-2">{articles.map((a) => <ArticleCard article={a} />)}</div>
      </div>
    </section>
  )}
  <CtaBand title="Envie d’en parler ?" text="Décrivez-nous votre objectif et votre situation : nous vous dirons quelle formule a du sens pour vous." primary={{ label: 'Réserver un Bilan Diagnostic', href: '/runcare/bilan' }} whatsapp={whatsappCoachingUrl('Bonjour, je souhaite échanger sur un accompagnement coaching.')} />
</Base>
