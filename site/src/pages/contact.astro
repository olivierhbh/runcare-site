---
import { getCollection } from 'astro:content';
import Base from '@/layouts/Base.astro';
import Faq from '@/components/Faq.astro';
import { settings, telHref, whatsappUrl, whatsappCoachingUrl, mapsHref } from '@/lib/settings';
const faq = (await getCollection('faq')).sort((a, b) => a.data.ordre - b.data.ordre);
---
<Base title="Contact & rendez-vous" description="Prendre rendez-vous au cabinet Argonne Kiné Sport Santé, 130 cours de l'Argonne à Bordeaux, ou nous écrire sur WhatsApp pour RunCare. Réponses aux questions fréquentes.">
  <section class="container pt-14 md:pt-20 pb-12">
    <p class="eyebrow mb-4">Contact & rendez-vous</p>
    <h1 class="text-[clamp(2.4rem,5.5vw,4rem)] max-w-[16ch]">Décrivez-nous votre situation.</h1>
    <p class="mt-6 text-lg muted max-w-[58ch]">Vous ne savez pas quel service choisir ? Écrivez-nous simplement : nous vous orienterons vers la solution la plus adaptée.</p>
  </section>

  <section class="container pb-20 grid gap-5 md:grid-cols-3">
    <div class="bg-surface border hairline rounded-brand p-7">
      <p class="eyebrow mb-3">Kinésithérapie</p>
      <h2 class="text-2xl mb-3">Au cabinet</h2>
      <p class="muted text-sm leading-relaxed mb-5">Séances de kinésithérapie sur prescription, rééducation, préparation physique.</p>
      <a href={settings.doctolibRomain} class="btn btn-primary w-full justify-center" rel="noopener">Doctolib — Romain</a>
      <a href={settings.doctolibLelio} class="btn btn-ghost w-full justify-center mt-2" rel="noopener">Doctolib — Lelio</a>
    </div>
    <div class="bg-surface border hairline rounded-brand p-7">
      <p class="eyebrow mb-3">RunCare</p>
      <h2 class="text-2xl mb-3">Par message</h2>
      <p class="muted text-sm leading-relaxed mb-5">Pour toute question sur le <a class="text-accent hover:underline" href="/runcare/bilan">bilan</a>, l’<a class="text-accent hover:underline" href="/runcare/analyse-de-foulee">analyse de foulée</a> ou le <a class="text-accent hover:underline" href="/runcare/coaching">coaching</a>.</p>
      <a href={whatsappUrl('Bonjour, je souhaite vous décrire ma situation.')} class="btn btn-primary w-full justify-center" rel="noopener">Écrire sur WhatsApp</a>
      <a href={whatsappCoachingUrl('Bonjour, je souhaite échanger sur un accompagnement coaching.')} class="btn btn-ghost w-full justify-center mt-2" rel="noopener">WhatsApp coaching</a>
    </div>
    <div class="bg-surface border hairline rounded-brand p-7">
      <p class="eyebrow mb-3">Cabinet</p>
      <h2 class="text-2xl mb-3">{settings.ville}</h2>
      <address class="not-italic text-sm leading-relaxed space-y-1.5">
        <p>{settings.adresse}<br />{settings.codePostal} {settings.ville}</p>
        <p>Romain : <a class="text-accent" href={telHref}>{settings.telephone}</a><br />Lelio : <a class="text-accent" href={`tel:+33${settings.telephoneLelio.replace(/\D/g, '').replace(/^0/, '')}`}>{settings.telephoneLelio}</a></p>
        <p><a class="text-accent" href={`mailto:${settings.email}`}>{settings.email}</a></p>
        <p class="muted whitespace-pre-line">{settings.horaires}</p>
      </address>
      <a href={mapsHref} class="btn btn-ghost w-full justify-center mt-5" rel="noopener">Itinéraire &amp; avis Google</a>
    </div>
  </section>

  <section class="section bg-bg-2">
    <div class="container grid gap-10 lg:grid-cols-[1fr_2fr]">
      <div><p class="eyebrow mb-4">FAQ</p><h2 class="text-[clamp(1.8rem,3.5vw,2.6rem)]">Questions fréquentes</h2></div>
      <Faq items={faq.map((f) => ({ question: f.data.question, reponse: f.data.reponse }))} />
    </div>
  </section>
</Base>
