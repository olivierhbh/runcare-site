---
import { getCollection } from 'astro:content';
import Base from '@/layouts/Base.astro';
import Faq from '@/components/Faq.astro';
import RuncareNote from '@/components/RuncareNote.astro';
import { settings, whatsappUrl, whatsappCoachingUrl } from '@/lib/settings';
const faq = (await getCollection('faq')).sort((a, b) => a.data.ordre - b.data.ordre);
const mapQuery = encodeURIComponent(`${settings.adresse}, ${settings.codePostal} ${settings.ville}`);
const telCabHref = `tel:+33${settings.telephoneCabinet.replace(/\D/g, '').replace(/^0/, '')}`;
---
<Base title="Contact & rendez-vous" description="Prendre rendez-vous au cabinet Argonne Kiné Sport Santé, 130 cours de l'Argonne à Bordeaux, ou contacter RunCare pour un bilan, une analyse de foulée ou un coaching.">
  <section class="container pt-14 md:pt-20 pb-12">
    <p class="eyebrow mb-4">Contact & rendez-vous</p>
    <h1 class="text-[clamp(2.4rem,5.5vw,4rem)] max-w-[16ch]">Décris-nous ta situation.</h1>
    <p class="mt-6 text-lg muted max-w-[58ch]">Tu ne sais pas quel service choisir ? Écris-nous simplement : nous t’orienterons vers la solution la plus adaptée.</p>
  </section>

  <section class="container pb-10 grid gap-5 md:grid-cols-2">
    <div class="bg-surface border-2 rounded-brand p-7 flex flex-col" style="border-color: var(--argonne)">
      <p class="text-xs font-semibold tracking-[0.18em] uppercase mb-3" style="color: var(--argonne)">Argonne Kiné Sport Santé</p>
      <h2 class="text-2xl mb-3">Rééducation au cabinet</h2>
      <ul class="text-sm space-y-2 mb-6 muted">
        <li>{settings.adresse}, {settings.codePostal} {settings.ville}</li>
        <li>Du lundi au vendredi, sur rendez-vous</li>
        <li>Téléphone : <a class="hover:text-accent font-medium" href={telCabHref}>{settings.telephoneCabinet}</a></li>
      </ul>
      <a href={settings.doctolibLelio} class="btn btn-primary w-full justify-center mt-auto" rel="noopener" style="background: var(--argonne)">Prendre rendez-vous sur Doctolib</a>
      <a href={`https://www.google.com/maps/search/?api=1&query=${mapQuery}`} class="btn btn-ghost w-full justify-center mt-2" rel="noopener">Itinéraire</a>
    </div>
    <div class="bg-surface border-2 border-accent rounded-brand p-7 flex flex-col">
      <p class="text-xs font-semibold tracking-[0.18em] uppercase mb-3 text-accent">RunCare</p>
      <h2 class="text-2xl mb-3">Bilan, analyse de foulée, coaching</h2>
      <ul class="text-sm space-y-2 mb-6 muted">
        <li>E-mail : <a class="hover:text-accent font-medium" href={`mailto:${settings.emailRuncare}`}>{settings.emailRuncare}</a></li>
        <li>Le plus simple : décris-nous ta situation sur WhatsApp.</li>
      </ul>
      <a href={whatsappUrl('Bonjour, je souhaite décrire ma situation.')} class="btn btn-primary w-full justify-center mt-auto" rel="noopener">WhatsApp Romain</a>
      <a href={whatsappCoachingUrl('Bonjour, je souhaite décrire ma situation.')} class="btn btn-ghost w-full justify-center mt-2" rel="noopener">WhatsApp Lelio</a>
    </div>
  </section>
  <div class="container pb-16"><RuncareNote class="max-w-3xl" /></div>

  <section class="section bg-bg-2">
    <div class="container grid gap-10 lg:grid-cols-[1fr_2fr]">
      <div>
        <p class="eyebrow mb-4">Questions fréquentes</p>
        <h2 class="text-[clamp(1.8rem,3.5vw,2.6rem)]">Toutes les réponses à tes questions.</h2>
      </div>
      <Faq items={faq.map((f) => ({ question: f.data.question, reponse: f.data.reponse }))} />
    </div>
  </section>
</Base>
