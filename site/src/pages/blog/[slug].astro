---
import { getCollection, render } from 'astro:content';
import Base from '@/layouts/Base.astro';
import { Image } from 'astro:assets';
import CtaBand from '@/components/CtaBand.astro';
import { serviceLabels, settings } from '@/lib/settings';
import ArticleCardLite from '@/components/ArticleCard.astro';
export async function getStaticPaths() {
  const articles = await getCollection('articles');
  return articles.map((a) => ({ params: { slug: a.id }, props: { entry: a } }));
}
const { entry } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;
const date = d.publishedDate.toLocaleDateString('fr-FR', { day: 'numeric', month: 'long', year: 'numeric' });
const others = (await getCollection('articles')).filter((a) => a.id !== entry.id).slice(0, 3);
const vente = { label: 'Découvrir le Bilan Diagnostic RunCare', href: settings.venteUrl };
const ctaByService: Record<string, { text: string; primary: { label: string; href: string }; secondary?: { label: string; href: string } }> = {
  'reeducation': { text: 'Une douleur qui persiste ? Prends rendez-vous au cabinet, ou fais le point sur ta situation avec un bilan.', primary: { label: 'Prendre rendez-vous sur Doctolib', href: settings.doctolibLelio }, secondary: { label: 'Le Bilan Diagnostic RunCare', href: '/bilan-runcare' } },
  'bilan-runcare': { text: 'Pour comprendre ce qui se joue dans ton cas, le bilan croise ton historique, ton entraînement et tes capacités.', primary: vente },
  'analyse-de-foulee': { text: 'Avant de modifier ta foulée, fais d’abord le point sur ta situation globale avec un bilan.', primary: vente, secondary: { label: 'Voir l’analyse de foulée', href: '/analyse-de-foulee' } },
  'coaching': { text: 'Chaque accompagnement commence par un bilan, offert avec chaque formule de coaching.', primary: vente, secondary: { label: 'Voir les formules de coaching', href: '/coaching' } },
};
const cta = ctaByService[d.service];
---
<Base title={d.title} description={d.description}>
  <article class="container pt-14 md:pt-20 pb-20">
    <div class="max-w-[62ch]">
      <p class="text-xs muted mb-4 flex gap-2"><a class="text-accent font-semibold uppercase tracking-[0.12em]" href={ctaByService[d.service].href}>{serviceLabels[d.service]}</a><span>·</span><time>{date}</time></p>
      <h1 class="text-[clamp(2.2rem,5vw,3.6rem)]">{d.title}</h1>
      <p class="mt-6 text-lg muted leading-relaxed">{d.description}</p>
    </div>
    {d.cover && <div class="rounded-brand overflow-hidden aspect-[21/9] bg-bg-2 mt-10 max-w-4xl"><Image src={d.cover} alt="" width={1600} class="w-full h-full object-cover img-tone" /></div>}
    <div class="prose mt-12"><Content /></div>
    <div class="max-w-[62ch] mt-14 rounded-brand bg-accent-soft p-7">
      <p class="eyebrow mb-2">Aller plus loin</p>
      <p class="mb-5">{cta.text}</p>
      <div class="flex flex-wrap gap-3">
        <a href={cta.primary.href} class="btn btn-primary" rel="noopener">{cta.primary.label}</a>
        {cta.secondary && <a href={cta.secondary.href} class="btn btn-ghost">{cta.secondary.label}</a>}
      </div>
    </div>
  </article>
  <section class="section bg-bg-2 pt-14">
    <div class="container">
      <p class="eyebrow mb-4">À lire aussi</p>
      <div class="grid gap-5 md:grid-cols-3">{others.map((a) => <ArticleCardLite article={a} />)}</div>
    </div>
  </section>
  <CtaBand />
</Base>
