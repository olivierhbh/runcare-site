---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '@/layouts/Base.astro';
import ServiceCard from '@/components/ServiceCard.astro';
import Faq from '@/components/Faq.astro';
import CtaBand from '@/components/CtaBand.astro';
import Logo from '@/components/Logo.astro';
import { settings, servicePath, cabinet, mapsHref } from '@/lib/settings';
import duo from '@/assets/photos/duo.jpg';
import quai from '@/assets/photos/bordeaux-quai.jpg';
import salleTapis from '@/assets/photos/cabinet/salle-tapis.jpg';
import salleEspaliers from '@/assets/photos/cabinet/salle-espaliers.jpg';
import salleVelos from '@/assets/photos/cabinet/salle-velos.jpg';

const services = (await getCollection('services')).sort((a, b) => a.data.ordre - b.data.ordre);
const kine = services.find((s) => s.id === 'reeducation')!;
const runcareServices = services.filter((s) => s.id !== 'reeducation');
const equipe = (await getCollection('equipe')).sort((a, b) => a.data.ordre - b.data.ordre);
const faq = (await getCollection('faq')).filter((f) => f.data.accueil).sort((a, b) => a.data.ordre - b.data.ordre);
---
<Base title={`${cabinet.nom} — kinésithérapie du sport à Bordeaux`} description="Cabinet de kinésithérapie du sport dédié au coureur à pied, à Bordeaux (130 cours de l'Argonne) : rééducation des blessures de course, et RunCare — bilan, analyse de foulée, coaching. Traiter la blessure, prévenir la récidive, progresser durablement.">
  <!-- Hero -->
  <section class="container pt-16 md:pt-24 pb-14">
    <p class="eyebrow mb-5">Cabinet de kinésithérapie du sport & du coureur · Bordeaux</p>
    <h1 class="text-[clamp(2.6rem,6.5vw,5rem)] max-w-[15ch]">Traiter la blessure, prévenir la récidive, <em>progresser durablement.</em></h1>
    <div class="mt-8 grid gap-8 md:grid-cols-[1fr_auto] md:items-end">
      <p class="text-lg md:text-xl muted max-w-[52ch] leading-relaxed">Kinésithérapeutes du sport, coureurs et passionnés, nous mettons notre expertise clinique et notre expérience de terrain au service de votre pratique — au cabinet pour vous soigner, avec RunCare pour vous faire progresser.</p>
      <div class="flex flex-wrap gap-3">
        <a href="/kinesitherapie" class="btn btn-primary">Je suis blessé</a>
        <a href="/runcare" class="btn btn-ghost">Je veux progresser</a>
      </div>
    </div>
    <div class="mt-12 rounded-brand overflow-hidden aspect-[16/8] md:aspect-[21/9] bg-bg-2">
      <Image src={duo} alt="Romain et Lelio, kinésithérapeutes du sport, au cabinet" width={1800} class="w-full h-full object-cover img-tone" loading="eager" />
    </div>
  </section>

  <!-- Kinésithérapie -->
  <section class="section bg-bg-2">
    <div class="container grid gap-10 lg:grid-cols-[1fr_1fr] items-center">
      <div>
        <p class="eyebrow mb-4">Rééducation du coureur</p>
        <h2 class="text-[clamp(1.9rem,4vw,3rem)]">Traiter votre blessure, retrouver votre pratique.</h2>
        <p class="muted mt-5 text-lg leading-relaxed max-w-[50ch]">{kine.data.accroche} Séances sur prescription médicale, prises en charge par l’Assurance Maladie.</p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href="/kinesitherapie" class="btn btn-primary">La rééducation au cabinet</a>
          <a href={settings.doctolibRomain} class="btn btn-ghost" rel="noopener">Doctolib</a>
        </div>
      </div>
      {kine.data.photo && <div class="rounded-brand overflow-hidden aspect-[4/3] bg-bg-2"><Image src={kine.data.photo} alt="Séance de rééducation au cabinet" width={1200} class="w-full h-full object-cover img-tone" /></div>}
    </div>
  </section>

  <!-- RunCare -->
  <section class="section">
    <div class="container">
      <div class="flex flex-wrap items-end justify-between gap-6 mb-10">
        <div class="max-w-2xl">
          <Logo variant="runcare" size="md" />
          <h2 class="text-[clamp(1.9rem,4vw,3rem)] mt-6">Coureur ? Découvrez RunCare, notre programme dédié à la course à pied.</h2>
          <p class="muted mt-5 text-lg leading-relaxed max-w-[52ch]">Bilan diagnostic, analyse de foulée et coaching : de la kinésithérapie préventive, par vos kinés du sport, pour prévenir la récidive et progresser durablement. Actes hors nomenclature, non remboursés.</p>
        </div>
        <a href="/runcare" class="btn btn-primary">Découvrir RunCare</a>
      </div>
      <div class="grid gap-5 sm:grid-cols-3">
        {runcareServices.map((s, i) => (
          <ServiceCard href={servicePath[s.id]} besoin={s.data.besoin} titre={s.data.titre} accroche={s.data.accroche} photo={s.data.photo} index={i + 2} />
        ))}
      </div>
    </div>
  </section>

  <!-- Le cabinet -->
  <section class="section pt-0">
    <div class="container">
      <div class="flex flex-wrap items-end justify-between gap-6 mb-8">
        <div class="max-w-2xl">
          <p class="eyebrow mb-4">Le cabinet</p>
          <h2 class="text-[clamp(1.9rem,4vw,3rem)]">Un plateau technique pensé pour le coureur.</h2>
          <p class="muted mt-4 text-lg leading-relaxed max-w-[52ch]">Tapis de course, vélos, espaliers, charges libres : de quoi évaluer, rééduquer et renforcer, au 130 cours de l’Argonne.</p>
        </div>
        <a href={mapsHref} class="btn btn-ghost" rel="noopener">Itinéraire &amp; avis Google</a>
      </div>
      <div class="grid gap-4 md:grid-cols-[1.5fr_1fr_1fr]">
        <div class="rounded-brand overflow-hidden aspect-[4/3] md:aspect-auto md:row-span-2 bg-bg-2"><Image src={salleVelos} alt="Salle de rééducation du cabinet : vélos, espaliers et charges" width={1400} class="w-full h-full object-cover img-tone" /></div>
        <div class="rounded-brand overflow-hidden aspect-[4/3] bg-bg-2"><Image src={salleTapis} alt="Tapis de course du cabinet" width={800} class="w-full h-full object-cover img-tone" /></div>
        <div class="rounded-brand overflow-hidden aspect-[4/3] bg-bg-2"><Image src={salleEspaliers} alt="Espaliers et matériel de renforcement" width={800} class="w-full h-full object-cover img-tone" /></div>
      </div>
    </div>
  </section>

  <!-- Équipe -->
  <section class="section bg-bg-2">
    <div class="container">
      <div class="grid gap-10 lg:grid-cols-[1fr_1fr] items-start">
        <div class="rounded-brand overflow-hidden aspect-[4/3] bg-bg-2">
          <Image src={quai} alt="Coureur sur les quais de Bordeaux au petit matin" width={1200} class="w-full h-full object-cover img-tone" />
        </div>
        <div>
          <p class="eyebrow mb-4">Qui sommes-nous ?</p>
          <h2 class="text-[clamp(1.9rem,4vw,3rem)] mb-8">Kinés du sport, coachs et coureurs.</h2>
          <div class="space-y-7">
            {equipe.map((m) => (
              <div class="border-t hairline pt-6">
                <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
                  <h3 class="text-2xl">{`${m.id[0].toUpperCase()}${m.id.slice(1)}${m.data.nom ? ` ${m.data.nom}` : ''}`}</h3>
                  <p class="muted text-sm">{m.data.titres.join(' · ')}</p>
                </div>
                <p class="mt-3 serif italic text-lg leading-snug">« {m.data.philosophie} »</p>
              </div>
            ))}
          </div>
          <a href="/equipe" class="btn btn-ghost mt-8">Découvrir l’équipe</a>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="section">
    <div class="container grid gap-10 lg:grid-cols-[1fr_2fr]">
      <div>
        <p class="eyebrow mb-4">Questions fréquentes</p>
        <h2 class="text-[clamp(1.8rem,3.5vw,2.6rem)]">Ce que l’on nous demande souvent.</h2>
        <a href="/contact" class="btn btn-ghost mt-6">Toutes les questions</a>
      </div>
      <Faq items={faq.map((f) => ({ question: f.data.question, reponse: f.data.reponse }))} />
    </div>
  </section>

  <CtaBand title="Vous ne savez pas par où commencer ?" text="Décrivez-nous simplement votre situation : nous vous orienterons vers la prise en charge adaptée, rééducation au cabinet ou programme RunCare." />
</Base>
