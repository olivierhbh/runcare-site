---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '@/layouts/Base.astro';
import ServiceCard from '@/components/ServiceCard.astro';
import Faq from '@/components/Faq.astro';
import CtaBand from '@/components/CtaBand.astro';
import RuncareNote from '@/components/RuncareNote.astro';
import { settings } from '@/lib/settings';
import duo from '@/assets/photos/duo.jpg';
import quai from '@/assets/photos/bordeaux-quai.jpg';

const services = (await getCollection('services')).sort((a, b) => a.data.ordre - b.data.ordre);
const equipe = (await getCollection('equipe')).sort((a, b) => a.data.ordre - b.data.ordre);
const faq = (await getCollection('faq')).filter((f) => f.data.accueil).sort((a, b) => a.data.ordre - b.data.ordre);
---
<Base title="RunCare, kiné & coach du coureur à Bordeaux · Argonne Kiné Sport Santé" description="Cabinet de kinésithérapie dédié au coureur à pied à Bordeaux : rééducation, bilan, analyse de foulée et coaching. Traiter les blessures, prévenir la récidive, progresser durablement.">
  <!-- Hero -->
  <section class="container pt-12 md:pt-16 pb-14">
    <p class="eyebrow mb-5">Cabinet de kinésithérapie du coureur · Bordeaux</p>
    <h1 class="text-[clamp(2.2rem,5vw,3.6rem)] max-w-[18ch]">Traiter la blessure, prévenir la récidive, <em>progresser durablement.</em></h1>
    <div class="mt-8 grid gap-8 md:grid-cols-[1fr_auto] md:items-end">
      <p class="text-lg md:text-xl muted max-w-[52ch] leading-relaxed">Kinésithérapeutes du sport, coureurs et passionnés, nous mettons notre expertise clinique et notre expérience de terrain au service de ta pratique.</p>
      <div class="flex flex-wrap gap-3">
        <a href="#services" class="btn btn-primary">Trouver mon accompagnement</a>
        <a href="/contact" class="btn btn-ghost">Prendre rendez-vous</a>
      </div>
    </div>
    <div class="mt-10 rounded-brand overflow-hidden aspect-[16/7] md:aspect-[21/6] bg-bg-2">
      <Image src={quai} alt="Coureur sur les quais de Bordeaux au petit matin" width={1800} class="w-full h-full object-cover img-tone" loading="eager" />
    </div>
  </section>

  <!-- Services -->
  <section id="services" class="section bg-bg-2">
    <div class="container">
      <div class="max-w-2xl mb-12">
        <p class="eyebrow mb-4">Nos accompagnements</p>
        <h2 class="text-[clamp(1.9rem,4vw,3rem)]">Quel que soit ton besoin, nous t’orientons vers l’accompagnement adapté.</h2>
      </div>
      <div class="grid gap-10 lg:grid-cols-[1fr_3fr]">
        <div>
          <p class="text-xs font-semibold tracking-[0.18em] uppercase mb-4" style="color: var(--argonne)">Au cabinet · Argonne</p>
          <div class="grid gap-5">
            {services.filter((s) => s.id === 'reeducation').map((s) => (
              <ServiceCard href={`/${s.id}`} besoin={s.data.besoin} titre={s.data.titre} accroche={s.data.accroche} photo={s.data.photo} index={1} />
            ))}
          </div>
        </div>
        <div>
          <p class="text-xs font-semibold tracking-[0.18em] uppercase mb-4 text-accent">Prévention &amp; accompagnement · RunCare</p>
          <div class="grid gap-5 sm:grid-cols-2 xl:grid-cols-3">
            {services.filter((s) => s.id !== 'reeducation').map((s, i) => (
              <ServiceCard href={`/${s.id}`} besoin={s.data.besoin} titre={s.data.titre} accroche={s.data.accroche} photo={s.data.photo} index={i + 2} />
            ))}
          </div>
        </div>
      </div>
      <RuncareNote class="mt-8 max-w-3xl" />
    </div>
  </section>

  <!-- Équipe -->
  <section class="section">
    <div class="container">
      <div class="grid gap-10 lg:grid-cols-[1fr_1fr] items-start">
        <div class="rounded-brand overflow-hidden aspect-[4/3] bg-bg-2">
          <Image src={duo} alt="Romain et Lelio, kinésithérapeutes et coachs RunCare" width={1200} class="w-full h-full object-cover img-tone" />
        </div>
        <div>
          <p class="eyebrow mb-4">Qui sommes-nous ?</p>
          <h2 class="text-[clamp(1.9rem,4vw,3rem)] mb-8">Kinés du sport, coachs et coureurs.</h2>
          <div class="space-y-7">
            {equipe.map((m) => (
              <div class="border-t hairline pt-6">
                <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
                  <h3 class="text-2xl">{m.data.nom ? `${m.id[0].toUpperCase()}${m.id.slice(1)} ${m.data.nom}` : `${m.id[0].toUpperCase()}${m.id.slice(1)}`}</h3>
                  <p class="muted text-sm">{m.data.titres.join(' · ')}</p>
                </div>
                <p class="mt-3 serif italic text-lg leading-snug">« {m.data.philosophie} »</p>
              </div>
            ))}
          </div>
          <a href="/equipe" class="btn btn-ghost mt-8">Découvrir l’équipe</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Lead magnet -->
  <section class="section">
    <div class="container">
      <div class="rounded-brand bg-accent-soft p-8 md:p-14 grid gap-8 md:grid-cols-[1.4fr_1fr] items-center">
        <div>
          <p class="eyebrow mb-3">Quel coureur es-tu ?</p>
          <h2 class="text-[clamp(1.7rem,3.5vw,2.6rem)]">Évalue ton profil face aux risques de blessure.</h2>
          <p class="muted mt-4 max-w-[50ch]">Un questionnaire de quelques minutes pour situer ton profil et recevoir nos premiers conseils adaptés.</p>
        </div>
        <div class="md:justify-self-end">
          <a href={settings.leadMagnetUrl || '/profil-coureur'} class="btn btn-primary" rel="noopener">Déterminer mon profil</a>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="section pt-0">
    <div class="container grid gap-10 lg:grid-cols-[1fr_2fr]">
      <div>
        <p class="eyebrow mb-4">Questions fréquentes</p>
        <h2 class="text-[clamp(1.8rem,3.5vw,2.6rem)]">Ce que les coureurs nous demandent souvent.</h2>
        <a href="/contact" class="btn btn-ghost mt-6">Toutes les questions</a>
      </div>
      <Faq items={faq.map((f) => ({ question: f.data.question, reponse: f.data.reponse }))} />
    </div>
  </section>

  <CtaBand />
</Base>
