---
import { getEntry, render } from 'astro:content';
import Base from '@/layouts/Base.astro';
const entry = (await getEntry('legal', 'mentions-legales'))!;
const { Content } = await render(entry);
---
<Base title={entry.data.titre} description="Mentions légales du site Argonne Kiné Sport Santé (RunCare).">
  <section class="container pt-14 md:pt-20 pb-24">
    <h1 class="text-[clamp(2rem,4.5vw,3.2rem)] mb-10">{entry.data.titre}</h1>
    <div class="prose"><Content /></div>
  </section>
</Base>
