---
import { getCollection, getEntry, render } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '@/layouts/Base.astro';
import PageHero from '@/components/PageHero.astro';
import CtaBand from '@/components/CtaBand.astro';
import ArticleCard from '@/components/ArticleCard.astro';
import RuncareNote from '@/components/RuncareNote.astro';
import { whatsappUrl, whatsappCoachingUrl } from '@/lib/settings';
import nolio from '@/assets/photos/nolio.jpg';
import coachingTel from '@/assets/photos/coaching-tel.jpg';

const entry = (await getEntry('services', 'coaching'))!;
const { Content } = await render(entry);
const d = entry.data;
const formules = (await getCollection('formules')).sort((a, b) => a.data.ordre - b.data.ordre);
const articles = (await getCollection('articles')).filter((a) => a.data.service === 'coaching');
// Gestion de charge (fichier essentiel.yaml) → WhatsApp Romain ; Premium → WhatsApp Lelio (consigne Romain, 01/09/2026).
const formuleWhatsapp = (id: string, nom: string) =>
  (id === 'essentiel' ? whatsappUrl : whatsappCoachingUrl)(`Bonjour, je suis intéressé(e) par la formule ${nom}.`);
---
<Base title="Coaching RunCare" description={d.accroche} ogImage={nolio.src}>
  <PageHero eyebrow={d.besoin} title={d.titre} intro={d.intro} photo={coachingTel} photoAlt="Coureur consultant son plan d'entraînement" />

  <section class="container pb-16">
    <div class="grid gap-5 md:grid-cols-2 max-w-4xl mx-auto">
      {formules.map((f) => (
        <article class:list={['rounded-brand border p-7 flex flex-col gap-6 md:grid md:grid-rows-subgrid md:row-span-7 md:gap-y-6', f.data.misEnAvant ? 'on-dark border-transparent' : 'bg-surface hairline']}>
          <div>
            <p class="eyebrow mb-2">{f.data.sousTitre}</p>
            <h2 class="text-3xl">{f.data.nom}</h2>
            <p class="mt-3 muted leading-relaxed text-[0.95rem]">{f.data.description}</p>
          </div>
          <p class:list={['self-start inline-flex items-center gap-2 text-xs font-semibold tracking-wide uppercase rounded-full px-3 py-1.5', f.data.misEnAvant ? 'bg-[color-mix(in_srgb,currentColor_14%,transparent)]' : 'bg-accent-soft text-accent']}>Bilan Diagnostic (90 €) offert</p>
          <ul class="space-y-2 text-sm">
            {f.data.inclus.map((x) => <li class="flex gap-2.5"><span class="mt-0.5 shrink-0" style={f.data.misEnAvant ? '' : 'color: var(--accent)'}>✓</span><span>{x}</span></li>)}
          </ul>
          <p class="serif text-3xl self-end -mb-4">{f.data.tarif}</p>
          <div class="self-end">
            <p class="text-sm muted">{f.data.format} · Engagement {f.data.engagement}</p>
            <p class="text-xs muted mt-1">{f.data.tarifDetail}</p>
          </div>
          <a href={formuleWhatsapp(f.id, f.data.nom)} class="btn btn-primary w-full justify-center" rel="noopener">Choisir {f.data.nom}</a>
          <p class="text-sm border-t pt-4" style="border-color: color-mix(in srgb, currentColor 15%, transparent)"><span class="font-semibold">Idéal si :</span> {f.data.idealSi}</p>
        </article>
      ))}
    </div>
    <RuncareNote class="mt-8 max-w-4xl mx-auto" />
  </section>

  <section class="section bg-bg-2">
    <div class="container">
      <div class="prose max-w-[70ch] mb-14"><Content /></div>
      <div>
        <p class="eyebrow mb-4">Ton suivi digital</p>
        <h2 class="text-[clamp(1.8rem,3.5vw,2.6rem)] mb-8 max-w-2xl">Un exemple de programmation d’entraînement sur la plateforme Nolio.</h2>
        <div class="rounded-brand overflow-hidden border hairline bg-surface p-3 shadow-sm">
          <Image src={nolio} alt="Exemple de programmation d'entraînement sur la plateforme Nolio" width={2000} class="w-full rounded-[calc(var(--radius)-2px)]" />
          <p class="text-xs muted px-2 pt-3 pb-1">Exemple de programmation d’un coureur sur la plateforme Nolio.</p>
        </div>
      </div>
    </div>
  </section>

  {articles.length > 0 && (
    <section class="section pt-0">
      <div class="container">
        <p class="eyebrow mb-4">Pour aller plus loin</p>
        <div class="grid gap-5 md:grid-cols-2">{articles.map((a) => <ArticleCard article={a} />)}</div>
      </div>
    </section>
  )}
  <CtaBand title="Envie d’en parler ?" text="Décris-nous ton objectif et ta situation : nous te dirons quelle formule a du sens pour toi." />
</Base>
